generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DISABLED
}

enum Qualification {
  SSLC
  PLUS_TWO
  DIPLOMA
  DEGREE
  POST_GRADUATION
  OTHER
}

enum DocumentType {
  AADHAAR
  PAN
  PASSPORT
  OTHER
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum OtpPurpose {
  REGISTRATION
  FORGOT_PASSWORD
  PHONE_VERIFICATION
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  PAUSED
  CANCELLED
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  MULTIPLE_SELECT
  TEXT
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EVALUATED
}

enum NotificationType {
  ASSIGNMENT
  ASSESSMENT
  FEEDBACK
  ANNOUNCEMENT
  COURSE
  SYSTEM
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  phone           String           @unique @db.VarChar(16)
  passwordHash    String
  role            UserRole         @default(STUDENT)
  status          UserStatus       @default(PENDING_VERIFICATION)
  phoneVerifiedAt DateTime?        @db.Timestamptz(3)
  lastLoginAt     DateTime?        @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
  profile         StudentProfile?
  refreshSessions RefreshSession[]

  @@index([role])
  @@index([status])
}

model StudentProfile {
  id                   String              @id @default(uuid()) @db.Uuid
  userId               String              @unique @db.Uuid
  fullName             String
  highestQualification Qualification
  otherQualification   String?
  profilePhotoKey      String?
  studentCode          String              @unique
  createdAt            DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime            @updatedAt @db.Timestamptz(3)
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents            StudentDocument[]
  enrollments          Enrollment[]
  attempts             AssessmentAttempt[]
  notifications        Notification[]
  certificates         Certificate[]
}

model StudentDocument {
  id                 String             @id @default(uuid()) @db.Uuid
  studentId          String             @db.Uuid
  documentType       DocumentType
  storageKey         String
  originalFileName   String
  mimeType           String
  fileSizeBytes      BigInt
  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt         DateTime?          @db.Timestamptz(3)
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(3)
  student            StudentProfile     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
}

model OtpVerification {
  id           String     @id @default(uuid()) @db.Uuid
  phone        String     @db.VarChar(16)
  purpose      OtpPurpose
  otpHash      String
  expiresAt    DateTime   @db.Timestamptz(3)
  verifiedAt   DateTime?  @db.Timestamptz(3)
  attemptCount Int        @default(0)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)

  @@index([phone, purpose, createdAt])
  @@index([expiresAt])
}

model RefreshSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  userAgent String?
  ipAddress String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model Course {
  id            String        @id @default(uuid()) @db.Uuid
  title         String
  slug          String        @unique
  description   String?       @db.Text
  thumbnailKey  String?
  durationWeeks Int
  status        CourseStatus  @default(DRAFT)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)
  enrollments   Enrollment[]
  weeks         CourseWeek[]
  certificates  Certificate[]

  @@index([status])
  @@index([createdAt])
}

model Enrollment {
  id          String           @id @default(uuid()) @db.Uuid
  studentId   String           @db.Uuid
  courseId    String           @db.Uuid
  status      EnrollmentStatus @default(ACTIVE)
  enrolledAt  DateTime         @default(now()) @db.Timestamptz(3)
  startedAt   DateTime?        @db.Timestamptz(3)
  completedAt DateTime?        @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  student     StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([studentId, courseId])
  @@index([courseId, status])
  @@index([studentId, status])
}

model CourseWeek {
  id          String       @id @default(uuid()) @db.Uuid
  courseId    String       @db.Uuid
  weekNumber  Int
  title       String
  description String?      @db.Text
  isPublished Boolean      @default(false)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  assessments Assessment[]

  @@unique([courseId, weekNumber])
  @@index([courseId, isPublished])
}

model Assessment {
  id              String               @id @default(uuid()) @db.Uuid
  weekId          String               @db.Uuid
  title           String
  description     String?              @db.Text
  durationMinutes Int?
  totalMarks      Int
  passingMarks    Int
  attemptLimit    Int                  @default(1)
  isPublished     Boolean              @default(false)
  createdAt       DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @db.Timestamptz(3)
  week            CourseWeek           @relation(fields: [weekId], references: [id], onDelete: Cascade)
  questions       AssessmentQuestion[]
  attempts        AssessmentAttempt[]

  @@index([weekId, isPublished])
}

model AssessmentQuestion {
  id            String             @id @default(uuid()) @db.Uuid
  assessmentId  String             @db.Uuid
  questionText  String             @db.Text
  questionType  QuestionType
  marks         Int
  questionOrder Int
  assessment    Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  options       AssessmentOption[]
  answers       AssessmentAnswer[]

  @@unique([assessmentId, questionOrder])
  @@index([assessmentId])
}

model AssessmentOption {
  id          String             @id @default(uuid()) @db.Uuid
  questionId  String             @db.Uuid
  optionText  String             @db.Text
  isCorrect   Boolean            @default(false)
  optionOrder Int
  question    AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers     AssessmentAnswer[]

  @@unique([questionId, optionOrder])
  @@index([questionId])
}

model AssessmentAttempt {
  id            String             @id @default(uuid()) @db.Uuid
  assessmentId  String             @db.Uuid
  studentId     String             @db.Uuid
  attemptNumber Int
  startedAt     DateTime           @default(now()) @db.Timestamptz(3)
  submittedAt   DateTime?          @db.Timestamptz(3)
  score         Decimal?           @db.Decimal(8, 2)
  percentage    Decimal?           @db.Decimal(5, 2)
  status        AttemptStatus      @default(IN_PROGRESS)
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @db.Timestamptz(3)
  assessment    Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student       StudentProfile     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers       AssessmentAnswer[]

  @@unique([assessmentId, studentId, attemptNumber])
  @@index([studentId, assessmentId, status])
}

model AssessmentAnswer {
  id               String             @id @default(uuid()) @db.Uuid
  attemptId        String             @db.Uuid
  questionId       String             @db.Uuid
  selectedOptionId String?            @db.Uuid
  answerText       String?            @db.Text
  isCorrect        Boolean?
  marksObtained    Decimal?           @db.Decimal(8, 2)
  attempt          AssessmentAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question         AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)
  selectedOption   AssessmentOption?  @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  @@unique([attemptId, questionId])
  @@index([questionId])
}

model Notification {
  id            String           @id @default(uuid()) @db.Uuid
  studentId     String           @db.Uuid
  title         String
  message       String           @db.Text
  type          NotificationType
  referenceType String?
  referenceId   String?          @db.Uuid
  isRead        Boolean          @default(false)
  readAt        DateTime?        @db.Timestamptz(3)
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  student       StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, isRead, createdAt])
}

model Certificate {
  id                String         @id @default(uuid()) @db.Uuid
  studentId         String         @db.Uuid
  courseId          String         @db.Uuid
  certificateNumber String         @unique
  storageKey        String
  issuedAt          DateTime       @default(now()) @db.Timestamptz(3)
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  student           StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course            Course         @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([studentId, courseId])
  @@index([studentId, issuedAt])
}
