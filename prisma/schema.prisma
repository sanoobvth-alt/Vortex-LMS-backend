generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DISABLED
}

enum Qualification {
  SSLC
  PLUS_TWO
  DIPLOMA
  DEGREE
  POST_GRADUATION
  OTHER
}

enum DocumentType {
  AADHAAR
  PAN
  PASSPORT
  OTHER
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum OtpPurpose {
  REGISTRATION
  FORGOT_PASSWORD
  PHONE_VERIFICATION
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  PAUSED
  CANCELLED
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  MULTIPLE_SELECT
  TEXT
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EVALUATED
}

enum NotificationType {
  ASSIGNMENT
  ASSESSMENT
  FEEDBACK
  ANNOUNCEMENT
  COURSE
  SYSTEM
}

model User {
  id              String           @id @default(uuid()) @db.Uuid
  phone           String           @unique @db.VarChar(16)
  passwordHash    String
  role            UserRole         @default(STUDENT)
  status          UserStatus       @default(PENDING_VERIFICATION)
  phoneVerifiedAt DateTime?        @db.Timestamptz(3)
  lastLoginAt     DateTime?        @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
  profile         StudentProfile?
  refreshSessions RefreshSession[]
  mediaAssets     MediaAsset[]

  @@index([role])
  @@index([status])
}

model StudentProfile {
  id                   String                 @id @default(uuid()) @db.Uuid
  userId               String                 @unique @db.Uuid
  fullName             String
  highestQualification Qualification
  otherQualification   String?
  profilePhotoKey      String?
  studentCode          String                 @unique
  createdAt            DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime               @updatedAt @db.Timestamptz(3)
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents            StudentDocument[]
  enrollments          Enrollment[]
  attempts             AssessmentAttempt[]
  notifications        Notification[]
  certificates         Certificate[]
  assignments          AssignmentSubmission[]
}

model StudentDocument {
  id                 String             @id @default(uuid()) @db.Uuid
  studentId          String             @db.Uuid
  documentType       DocumentType
  storageKey         String
  originalFileName   String
  mimeType           String
  fileSizeBytes      BigInt
  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt         DateTime?          @db.Timestamptz(3)
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(3)
  student            StudentProfile     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
}

model OtpVerification {
  id           String     @id @default(uuid()) @db.Uuid
  phone        String     @db.VarChar(16)
  purpose      OtpPurpose
  otpHash      String
  expiresAt    DateTime   @db.Timestamptz(3)
  verifiedAt   DateTime?  @db.Timestamptz(3)
  attemptCount Int        @default(0)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)

  @@index([phone, purpose, createdAt])
  @@index([expiresAt])
}

model RefreshSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  userAgent String?
  ipAddress String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model Course {
  id               String           @id @default(uuid()) @db.Uuid
  title            String
  slug             String           @unique
  description      String?          @db.Text
  thumbnailKey     String?
  thumbnailAssetId String?          @unique @db.Uuid
  durationWeeks    Int
  status           CourseStatus     @default(DRAFT)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)
  enrollments      Enrollment[]
  weeks            CourseWeek[]
  certificates     Certificate[]
  materials        CourseMaterial[]
  assignments      Assignment[]
  mediaAssets      MediaAsset[]     @relation("CourseAssets")
  thumbnailAsset   MediaAsset?      @relation("CourseThumbnail", fields: [thumbnailAssetId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
}

model Enrollment {
  id          String           @id @default(uuid()) @db.Uuid
  studentId   String           @db.Uuid
  courseId    String           @db.Uuid
  status      EnrollmentStatus @default(ACTIVE)
  enrolledAt  DateTime         @default(now()) @db.Timestamptz(3)
  startedAt   DateTime?        @db.Timestamptz(3)
  completedAt DateTime?        @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  student     StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([studentId, courseId])
  @@index([courseId, status])
  @@index([studentId, status])
}

model CourseWeek {
  id               String           @id @default(uuid()) @db.Uuid
  courseId         String           @db.Uuid
  weekNumber       Int
  title            String
  description      String?          @db.Text
  thumbnailKey     String?
  thumbnailAssetId String?          @unique @db.Uuid
  isPublished      Boolean          @default(false)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)
  course           Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  assessments      Assessment[]
  materials        CourseMaterial[]
  assignments      Assignment[]
  thumbnailAsset   MediaAsset?      @relation("WeekThumbnail", fields: [thumbnailAssetId], references: [id], onDelete: SetNull)

  @@unique([courseId, weekNumber])
  @@index([courseId, isPublished])
}

model Assessment {
  id              String               @id @default(uuid()) @db.Uuid
  weekId          String               @db.Uuid
  title           String
  description     String?              @db.Text
  durationMinutes Int?
  totalMarks      Int
  passingMarks    Int
  attemptLimit    Int                  @default(1)
  isPublished     Boolean              @default(false)
  createdAt       DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @db.Timestamptz(3)
  week            CourseWeek           @relation(fields: [weekId], references: [id], onDelete: Cascade)
  questions       AssessmentQuestion[]
  attempts        AssessmentAttempt[]

  @@index([weekId, isPublished])
}

model AssessmentQuestion {
  id            String             @id @default(uuid()) @db.Uuid
  assessmentId  String             @db.Uuid
  questionText  String             @db.Text
  questionType  QuestionType
  marks         Int
  questionOrder Int
  assessment    Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  options       AssessmentOption[]
  answers       AssessmentAnswer[]

  @@unique([assessmentId, questionOrder])
  @@index([assessmentId])
}

model AssessmentOption {
  id          String             @id @default(uuid()) @db.Uuid
  questionId  String             @db.Uuid
  optionText  String             @db.Text
  isCorrect   Boolean            @default(false)
  optionOrder Int
  question    AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers     AssessmentAnswer[]

  @@unique([questionId, optionOrder])
  @@index([questionId])
}

model AssessmentAttempt {
  id            String             @id @default(uuid()) @db.Uuid
  assessmentId  String             @db.Uuid
  studentId     String             @db.Uuid
  attemptNumber Int
  startedAt     DateTime           @default(now()) @db.Timestamptz(3)
  submittedAt   DateTime?          @db.Timestamptz(3)
  score         Decimal?           @db.Decimal(8, 2)
  percentage    Decimal?           @db.Decimal(5, 2)
  status        AttemptStatus      @default(IN_PROGRESS)
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @db.Timestamptz(3)
  assessment    Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student       StudentProfile     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers       AssessmentAnswer[]

  @@unique([assessmentId, studentId, attemptNumber])
  @@index([studentId, assessmentId, status])
}

model AssessmentAnswer {
  id               String             @id @default(uuid()) @db.Uuid
  attemptId        String             @db.Uuid
  questionId       String             @db.Uuid
  selectedOptionId String?            @db.Uuid
  answerText       String?            @db.Text
  isCorrect        Boolean?
  marksObtained    Decimal?           @db.Decimal(8, 2)
  attempt          AssessmentAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question         AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)
  selectedOption   AssessmentOption?  @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  @@unique([attemptId, questionId])
  @@index([questionId])
}

model Notification {
  id            String           @id @default(uuid()) @db.Uuid
  studentId     String           @db.Uuid
  title         String
  message       String           @db.Text
  type          NotificationType
  referenceType String?
  referenceId   String?          @db.Uuid
  isRead        Boolean          @default(false)
  readAt        DateTime?        @db.Timestamptz(3)
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)
  student       StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, isRead, createdAt])
}

model Certificate {
  id                String         @id @default(uuid()) @db.Uuid
  studentId         String         @db.Uuid
  courseId          String         @db.Uuid
  certificateNumber String         @unique
  storageKey        String
  mediaAssetId      String?        @db.Uuid
  issuedAt          DateTime       @default(now()) @db.Timestamptz(3)
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  student           StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course            Course         @relation(fields: [courseId], references: [id], onDelete: Restrict)
  mediaAsset        MediaAsset?    @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)

  @@unique([studentId, courseId])
  @@unique([mediaAssetId])
  @@index([studentId, issuedAt])
}

enum MediaPurpose {
  COURSE_PDF
  COURSE_THUMBNAIL
  MODULE_THUMBNAIL
  ASSIGNMENT_ATTACHMENT
  PROFILE_PHOTO
  IDENTITY_DOCUMENT
  CERTIFICATE
}

model MediaAsset {
  id                   String                @id @default(uuid()) @db.Uuid
  publicId             String                @unique
  cloudAssetId         String?
  secureUrl            String                @db.Text
  resourceType         String
  deliveryType         String
  format               String
  mimeType             String
  fileSizeBytes        BigInt
  originalFileName     String
  folder               String
  purpose              MediaPurpose
  deletionPending      Boolean               @default(false)
  ownerUserId          String                @db.Uuid
  courseId             String?               @db.Uuid
  createdAt            DateTime              @default(now()) @db.Timestamptz(3)
  owner                User                  @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  course               Course?               @relation("CourseAssets", fields: [courseId], references: [id], onDelete: Cascade)
  courseThumbnail      Course?               @relation("CourseThumbnail")
  weekThumbnail        CourseWeek?           @relation("WeekThumbnail")
  certificate          Certificate?
  courseMaterial       CourseMaterial?
  submissionAttachment SubmissionAttachment?

  @@index([ownerUserId, purpose, createdAt])
  @@index([courseId, purpose])
}

enum CourseMaterialType {
  YOUTUBE_VIDEO
  PDF_DOCUMENT
  SELF_LEARNING_TOPIC
}

model CourseMaterial {
  id           String             @id @default(uuid()) @db.Uuid
  courseId     String             @db.Uuid
  weekId       String             @db.Uuid
  type         CourseMaterialType
  title        String
  description  String?            @db.Text
  externalUrl  String?            @db.Text
  mediaAssetId String?            @db.Uuid
  sortOrder    Int                @default(0)
  createdAt    DateTime           @default(now()) @db.Timestamptz(3)
  course       Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  week         CourseWeek         @relation(fields: [weekId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset?        @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)

  @@unique([mediaAssetId])
  @@index([weekId, sortOrder])
}

model Assignment {
  id          String                 @id @default(uuid()) @db.Uuid
  courseId    String                 @db.Uuid
  weekId      String                 @db.Uuid
  title       String
  description String                 @db.Text
  isPublished Boolean                @default(false)
  dueAt       DateTime?              @db.Timestamptz(3)
  createdAt   DateTime               @default(now()) @db.Timestamptz(3)
  course      Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  week        CourseWeek             @relation(fields: [weekId], references: [id], onDelete: Cascade)
  submissions AssignmentSubmission[]

  @@index([weekId, isPublished])
}

model AssignmentSubmission {
  id           String                 @id @default(uuid()) @db.Uuid
  assignmentId String                 @db.Uuid
  studentId    String                 @db.Uuid
  submittedAt  DateTime               @default(now()) @db.Timestamptz(3)
  assignment   Assignment             @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      StudentProfile         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attachments  SubmissionAttachment[]

  @@unique([assignmentId, studentId])
  @@index([studentId, submittedAt])
}

model SubmissionAttachment {
  id           String               @id @default(uuid()) @db.Uuid
  submissionId String               @db.Uuid
  mediaAssetId String               @unique @db.Uuid
  submission   AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset           @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}
