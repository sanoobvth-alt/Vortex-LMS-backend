NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vortex_lms?schema=public
JWT_ACCESS_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
OTP_TTL_MINUTES=5
BCRYPT_SALT_ROUNDS=12
FRONTEND_URL=http://localhost:5173
UPLOAD_MAX_BYTES=5242880
UPLOAD_PROVIDER=local
UPLOAD_DIR=.private-uploads
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
STUDENT_CODE_PREFIX=VTX
ACTIVITY_TIMEZONE=UTC
